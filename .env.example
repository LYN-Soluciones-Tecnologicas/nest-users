# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=lyn_tenders

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Vectorization (embeddings)
# Options: 'local' (Transformers.js) or 'jina' (Jina API)
EMBEDDING_PROVIDER=local
JINA_API_KEY=

# LLM Provider (for smart search, AI tasks, pipeline)
# Options: 'openai', 'anthropic', 'ollama'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL= (optional, required for ollama e.g. http://localhost:11434)

# Data Sources - PLACSP Nacional
PLACSP_BASE_URL=https://contrataciondelsectorpublico.gob.es/sindicacion/sindicacion_643
PLACSP_ATOM_FILE=licitacionesPerfilesContratanteCompleto3.atom
PLACSP_MENORES_URL=https://contrataciondelsectorpublico.gob.es/sindicacion/sindicacion_1143

# Data Sources - Euskadi
EUSKADI_API_URL=https://opendata.euskadi.eus/webopd00-apicontract/es

# Data Sources - Cataluña
CATALUNA_PLACSP_AGREGACION=true

# Data Sources - Galicia
GALICIA_PLACSP_AGREGACION=true

# Company Profile
COMPANY_NAME=LYN Soluciones Tecnológicas
COMPANY_CPV_CODES=72000000,72200000,72300000,72400000,72500000,72600000

# App
PORT=3000
NODE_ENV=development
